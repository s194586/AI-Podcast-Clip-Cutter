# Copy this file to orchestration/airflow/.env.airflow and replace every
# change-me value before starting the stack. Keep passwords URL-safe because
# AIRFLOW_DB_PASSWORD is embedded in a PostgreSQL connection URL.
AIRFLOW_API_USERNAME=podcast_admin
AIRFLOW_API_PASSWORD=change-me-api-password
AIRFLOW_DB_PASSWORD=change-me-database-password
AIRFLOW_JWT_SECRET=change-me-at-least-32-random-characters

AIRFLOW_PORT=8080
APP_API_PORT=8010
WEB_PORT=5173
APP_DATA_HOST_PATH=./data
AIRFLOW_API_TIMEOUT_SECONDS=10

# Pyannote Community-1 is loaded by the scheduler task only. The stack can
# start with an empty token; a read token is required when pyannote mode runs.
DIARIZATION_MODE=pyannote
DIARIZATION_MODEL_ID=pyannote/speaker-diarization-community-1
DIARIZATION_MODEL_REVISION=3533c8cf8e369892e6b79ff1bf80f7b0286a54ee
DIARIZATION_DEVICE=cpu
DIARIZATION_NUM_SPEAKERS=
DIARIZATION_MIN_SPEAKERS=
DIARIZATION_MAX_SPEAKERS=
HF_TOKEN=
HF_HUB_OFFLINE=0

# Gemini is the normal semantic-review provider and never falls back silently.
# The stack still starts without a key; leave auto_review disabled for offline
# demos. local_stub is reserved for controlled tests such as smoke_docker.ps1.
CLIP_REVIEW_MODE=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_REQUEST_TIMEOUT_SECONDS=300
GEMINI_BATCH_TIMEOUT_SECONDS=1800

# Set this to true only when root-ca.pem has been placed in the fixed ignored
# directory orchestration/airflow/secrets/custom-ca.
CUSTOM_CA_REQUIRED=false
